{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@vercel/analytics/react": ["./node_modules/@vercel/analytics/dist/react/index.mjs"],
      "@vercel/analytics/next": ["./node_modules/@vercel/analytics/dist/next/index.mjs"],
      "@vercel/speed-insights/react": ["./node_modules/@vercel/speed-insights/dist/react/index.mjs"],
      "@vercel/speed-insights/next": ["./node_modules/@vercel/speed-insights/dist/next/index.mjs"]
    },
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
